{
  "uid": "chainindex-overview",
  "title": "ChainIndex Overview",
  "tags": ["chainindex"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Checkpoint next block",
      "description": "Head of the indexer's committed progress per stream. A flat line while the chain advances means indexing has stalled.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": { "custom": { "lineWidth": 2, "fillOpacity": 5 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "chainindex_checkpoint_next_block",
          "legendFormat": "chain {{chain_id}} / {{stream}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Blocks and events per second",
      "description": "Sustained ingestion throughput.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "lineWidth": 2, "fillOpacity": 5 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(chainindex_blocks_processed_total[1m]))",
          "legendFormat": "blocks/s"
        },
        {
          "refId": "B",
          "expr": "sum(rate(chainindex_events_processed_total[1m]))",
          "legendFormat": "events/s"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Reorgs detected",
      "description": "Increments when a stored block hash diverges from JSON-RPC and rollback runs. Non-zero is normal near the chain head; a sustained climb suggests confirmations are set too shallow.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "expr": "sum(chainindex_reorgs_total)", "legendFormat": "reorgs" }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Blocks rolled back",
      "description": "Total orphaned blocks deleted during reorg recovery. Read alongside the reorg count to gauge reorg depth.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 8 },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(chainindex_rollback_blocks_total)",
          "legendFormat": "blocks"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "RPC retries",
      "description": "Bounded exponential retries by operation. A rising rate points at provider rate limiting or instability.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": {
        "defaults": { "custom": { "lineWidth": 2, "fillOpacity": 5 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(chainindex_rpc_retries_total[1m])",
          "legendFormat": "{{operation}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Batch duration quantiles",
      "description": "Time to fetch, decode, and transactionally commit one batch.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "lineWidth": 2, "fillOpacity": 5 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum(rate(chainindex_batch_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum(rate(chainindex_batch_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum(rate(chainindex_batch_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Events by name",
      "description": "Decoded escrow lifecycle events: Deposited, Released, Refunded.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "fieldConfig": {
        "defaults": { "custom": { "lineWidth": 2, "fillOpacity": 10, "stacking": { "mode": "normal" } } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (event) (chainindex_events_processed_total)",
          "legendFormat": "{{event}}"
        }
      ]
    }
  ]
}
