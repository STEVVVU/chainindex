{
  "name": "chainindex",
  "version": "1.0.0",
  "private": true,
  "description": "Reorg-safe EVM event indexer and audited-style ETH escrow reference contract",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "npm run test:indexer && npm run test:contract",
    "test:indexer": "vitest run tests/indexer",
    "test:contract": "hardhat test",
    "coverage:indexer": "vitest run --coverage tests/indexer",
    "benchmark": "tsx benchmarks/indexer.ts",
    "start": "node dist/cli.js",
    "dev": "tsx src/cli.ts"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.6.1",
    "better-sqlite3": "^12.2.0",
    "ethers": "^6.15.0",
    "fastify": "^5.6.1",
    "prom-client": "^15.1.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.0",
    "@nomicfoundation/hardhat-ethers": "^3.1.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/chai": "^4.3.20",
    "@types/node": "^24.10.0",
    "@vitest/coverage-v8": "^4.0.4",
    "chai": "^4.5.0",
    "eslint": "^9.39.1",
    "hardhat": "^2.27.0",
    "solc": "0.8.28",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vitest": "^4.0.4"
  }
}
